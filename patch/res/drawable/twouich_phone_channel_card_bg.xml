<?xml version="1.0" encoding="utf-8"?>
<!-- Carte de l'écran de chaîne : la surface sombre de la marque, avec les deux
     coins supérieurs arrondis. Elle remplace le fond de couleur de l'amont, qui
     couvrait tout le tiers inférieur de l'écran en rouge. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#18181b" />
    <corners android:topLeftRadius="20dp" android:topRightRadius="20dp" />
</shape>

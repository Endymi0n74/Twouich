<?xml version="1.0" encoding="utf-8"?>
<!-- Panneau de chat du lecteur téléphone : surface pleine (et non un voile à
     45 % sur du noir) pour que la zone sous la vidéo se lise comme le chat et
     non comme un trou noir, avec les coins supérieurs arrondis côté Twitch. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#18181b" />
    <corners android:topLeftRadius="16dp" android:topRightRadius="16dp" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!-- Cartes du téléphone : le fond est transparent, seul l'OUTLINE compte. Il
     donne aux cartes la silhouette arrondie de l'interface de référence, et
     `android:clipToOutline` s'en sert pour rogner l'image qui remplit la carte
     (aucune peinture, donc rien ne recouvre le visuel au centre). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <corners android:radius="12dp" />
</shape>

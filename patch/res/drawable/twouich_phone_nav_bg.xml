<?xml version="1.0" encoding="utf-8"?>
<!-- Barre basse téléphone : surface opaque aux coins supérieurs arrondis.
     La barre est ancrée en bas, donc seuls les deux coins du haut se voient. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#0e0e10" />
    <corners android:topLeftRadius="18dp" android:topRightRadius="18dp" />
</shape>

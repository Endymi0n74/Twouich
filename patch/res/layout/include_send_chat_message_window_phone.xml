<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#18181b">
    <EditText
        android:id="@id/ET_SendMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="@drawable/twouich_phone_input_bg"
        android:textColor="@color/white"
        android:text=""
        android:hint="Envoyer un message"
        android:imeOptions="actionSend"
        android:inputType="text"
        android:singleLine="true"
        android:ems="10"
        android:textCursorDrawable="@null" />
    <ImageButton
        android:id="@+id/twouich_chat_send"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="2dp"
        android:padding="12dp"
        android:background="?android:attr/selectableItemBackground"
        android:src="@drawable/twouich_ic_send"
        android:tint="@color/theme_purple_bright"
        android:contentDescription="Envoyer le message"
        android:focusable="true"
        android:clickable="true"
        android:onClick="twouichPhoneSendChatMessage" />
    <ImageButton
        android:id="@+id/twouich_chat_options"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="2dp"
        android:padding="12dp"
        android:background="?android:attr/selectableItemBackground"
        android:src="@drawable/twouich_ic_more_vert"
        android:tint="@color/white"
        android:contentDescription="Options du lecteur"
        android:focusable="true"
        android:clickable="true"
        android:onClick="twouichPhoneToggleControls" />
</LinearLayout>
